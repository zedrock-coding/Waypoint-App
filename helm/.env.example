# Local development configuration for Helm.
#
# Copy to `.env` (git-ignored) and run:
#   flutter run --dart-define-from-file=.env
#
# Everything in here ends up inside the client build, so only PUBLIC values
# belong here. The Supabase publishable/anon key is meant to be public; RLS is
# what protects the data.
#
# The Gemini API key is NOT used by the app. It lives in the Supabase Edge
# Function environment:
#   supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
#
# For local AI development, run the function with its own env file:
#   supabase functions serve ai --env-file supabase/functions/.env.local
SUPABASE_URL=https://eknzdxexfcfdmqvbyvxt.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
