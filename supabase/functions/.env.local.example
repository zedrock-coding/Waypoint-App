# Local-only environment for `supabase functions serve ai`.
#
# Copy to supabase/functions/.env.local (git-ignored) and run:
#   supabase functions serve ai --env-file supabase/functions/.env.local
#
# The deployed function receives GEMINI_API_KEY from Supabase secrets instead:
#   supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
GEMINI_API_KEY=your_key_here
